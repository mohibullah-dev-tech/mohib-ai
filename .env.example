# Mohib AI (Friday) - Environment Configuration Template
# Copy this file to .env and adjust values as needed.

# Backend Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Brain & Model Provider Settings
# AI_PROVIDER options:
#   - "mock" (default, zero-cost, offline-friendly, no API key needed)
#   - "gemini" (cloud AI via Google Gemini Free tier)
AI_PROVIDER=mock
AI_MODEL_NAME=gemini-1.5-flash

# Optional: Google Gemini API Key (only required if AI_PROVIDER=gemini)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Frontend Settings
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
