# Mohib AI (Friday) - Environment Configuration Template
# Copy this file to .env and adjust values as needed.

# Backend Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Multi-Provider AI Intelligence Configuration
# Options: "auto" (default intelligent router), "gemini", "openai", "mock"
AI_PROVIDER=auto

# Google Gemini Settings (Get key at: https://aistudio.google.com/)
# Recommended models: "gemini-1.5-flash", "gemini-2.0-flash", "gemini-1.5-pro"
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Settings (Get key at: https://platform.openai.com/)
# Recommended models: "gpt-4o-mini", "gpt-4o"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Frontend Settings
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
